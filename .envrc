#!/usr/bin/env bash

# CI runs Node 18.1.0 (see .nvmrc); impunity breaks on Node 24, so `yarn test`
# needs it on PATH. Uses a local unpacked release if present, otherwise leaves
# PATH alone (nvm/fnm users pick the version up from .nvmrc instead).
NODE18_DIR="${NODE18_DIR:-$HOME/.local/node-18.1.0}"
if [ -x "$NODE18_DIR/bin/node" ]; then
	PATH_add "$NODE18_DIR/bin"
fi
export TZ=UTC
